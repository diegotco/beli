# ============================================================
# BELI - CREDENTIALS CONFIGURATION
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to ".env" (remove the .example)
# 2. Fill in each value with your real credentials
# 3. NEVER share the .env file with anyone
# ============================================================

# ------ ANTHROPIC (Beli's brain) ------
# Get it at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Claude model to use (options: claude-sonnet-4-5, claude-haiku-4-5-20251001)
# claude-sonnet-4-5  = smarter, more expensive (~$3/million input tokens)
# claude-haiku-4-5-20251001 = faster and cheaper (~$0.25/million input tokens)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ------ TELEGRAM BOT ------
# Get it by talking to @BotFather on Telegram:
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot
# 3. Choose a name for the bot (e.g. "Beli Assistant")
# 4. Choose a username (must end in "bot", e.g. "beli_assistant_bot")
# 5. BotFather will give you the token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=@your_bot_username

# ------ BELI SETTINGS ------
# Maximum number of previous messages Beli remembers per conversation
MEMORY_WINDOW=20

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ------ MONTHLY REMINDERS ------
# Hour at which Beli sends the reminder (24h format, local time)
REMINDER_HOUR=09
REMINDER_MINUTE=00
# How many days before end of month to send the reminder
REMINDER_DAYS_BEFORE_END=4

# ------ TELEGRAM USER API (optional — to read/send from your personal account) ------
# Get it at: https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Session string for your personal account (generated with setup_telegram_user.py)
OWNER_SESSION_STRING=

# ------ BELI'S TELEGRAM ACCOUNT (optional — her own account for sending messages) ------
# Beli's phone number in international format
BELI_TELEGRAM_PHONE=+1XXXXXXXXXX
# Session string for Beli's account (generated with setup_beli_telegram.py)
BELI_SESSION_STRING=

# ------ AGENTMAIL (Beli's own email address) ------
# API Key generated in the AgentMail dashboard (agentmail.to)
AGENTMAIL_API_KEY=your_agentmail_api_key_here
# Inbox ID: the full email address of the inbox created in AgentMail
AGENTMAIL_INBOX_ID=beli@agentmail.to
