# ============================================================
# BELI - CONFIGURACIÓN DE CREDENCIALES
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env" (sin el .example)
# 2. Rellena cada valor con tus credenciales reales
# 3. NUNCA compartas el archivo .env con nadie
# ============================================================

# ------ ANTHROPIC (Cerebro de Beli) ------
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Modelo de Claude a usar (opciones: claude-sonnet-4-6, claude-haiku-4-5-20251001)
# claude-sonnet-4-6 = más inteligente, más caro (~$3/millón tokens entrada)
# claude-haiku-4-5-20251001 = más rápido y barato (~$0.25/millón tokens entrada)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ------ TELEGRAM ------
# Obtener hablando con @BotFather en Telegram:
# 1. Abre Telegram y busca @BotFather
# 2. Envía /newbot
# 3. Elige un nombre para el bot (ej: "Beli Assistant")
# 4. Elige un username (debe terminar en "bot", ej: "beli_assistant_bot")
# 5. BotFather te dará el token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ------ CONFIGURACIÓN DE BELI ------
# Número máximo de mensajes anteriores que Beli recuerda por conversación
MEMORY_WINDOW=20

# Nivel de logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ------ TELEGRAM USER API (opcional — para leer/enviar desde tu cuenta personal) ------
# Obtener en: https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Session string de tu cuenta personal (generado con setup_telegram_user.py)
OWNER_SESSION_STRING=

# ------ CUENTA DE TELEGRAM DE BELI (opcional — cuenta propia para enviar mensajes) ------
# Número de teléfono de la cuenta de Beli en formato internacional
BELI_TELEGRAM_PHONE=+1XXXXXXXXXX
# Session string de la cuenta de Beli (generado con setup_beli_telegram.py)
BELI_SESSION_STRING=

# ------ AGENTMAIL (correo propio de Beli) ------
# API Key generada en el dashboard de AgentMail (agentmail.to)
AGENTMAIL_API_KEY=your_agentmail_api_key_here
# Inbox ID: el email completo de la bandeja creada en AgentMail
AGENTMAIL_INBOX_ID=beli@agentmail.to

# ------ RECORDATORIOS MENSUALES ------
# Hora a la que Beli manda el recordatorio (formato 24h, hora local)
REMINDER_HOUR=09
REMINDER_MINUTE=00
# Cuántos días antes del fin de mes enviar el recordatorio
REMINDER_DAYS_BEFORE_END=4
